<?xml version="1.0" encoding="utf-8"?>
<!-- CriCri Mods (Android 12+): what comes back after reinstalling the app. Only settings: without a list Android tries the whole 1 GB game folder,
     passes the 25 MB limit and backs up nothing. Logins and the CRICRI BR key stay out on purpose (no_backup, EOS keychain). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="external" path="com.innersloth.spacemafia/PersistentData/settings.amogus" />
        <include domain="external" path="com.innersloth.spacemafia/PersistentData/player.amogus" />
        <include domain="external" path="com.innersloth.spacemafia/PersistentData/regionInfo.json" />
        <include domain="external" path="com.innersloth.spacemafia/BepInEx/config" />
        <include domain="sharedpref" path="com.innersloth.spacemafia.v2.playerprefs.xml" />
        <include domain="sharedpref" path="cricri_mods.xml" />
        <include domain="sharedpref" path="cricri_otimizacoes.xml" />
        <include domain="sharedpref" path="cricri_guia.xml" />
        <include domain="sharedpref" path="cricri_atalho.xml" />
        <include domain="sharedpref" path="cricri_entrada_rapida.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="external" path="com.innersloth.spacemafia/PersistentData/settings.amogus" />
        <include domain="external" path="com.innersloth.spacemafia/PersistentData/player.amogus" />
        <include domain="external" path="com.innersloth.spacemafia/PersistentData/regionInfo.json" />
        <include domain="external" path="com.innersloth.spacemafia/BepInEx/config" />
        <include domain="sharedpref" path="com.innersloth.spacemafia.v2.playerprefs.xml" />
        <include domain="sharedpref" path="cricri_mods.xml" />
        <include domain="sharedpref" path="cricri_otimizacoes.xml" />
        <include domain="sharedpref" path="cricri_guia.xml" />
        <include domain="sharedpref" path="cricri_atalho.xml" />
        <include domain="sharedpref" path="cricri_entrada_rapida.xml" />
    </device-transfer>
</data-extraction-rules>
