<?xml version="1.0" encoding="utf-8"?>
<!-- The fixed play bar: a hairline on top, then the bar color. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cricri_linha" />
        </shape>
    </item>
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/cricri_barra" />
        </shape>
    </item>
</layer-list>
